{
  "name": "core_app",
  "version": "0.0.1",
  "description": "",
  "author": "Smart-team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build shared-dto && nest build auth-api && nest build core-app-api && nest build email-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "testByHand": "dotenv -e ./apps/auth/.test.env jest",
    "test:handle": "cross-env NODE_ENV=TEST jest --runInBand",
    "test": "jest --testPathIgnorePatterns='.*' --passWithNoTests",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=TEST jest --runInBand --testPathIgnorePatterns='.*' --passWithNoTests",
    "build:files": "nest build files",
    "build:auth": "nest build auth",
    "build:core_app": "nest build core_app",
    "build:log-service": "nest build log-service",
    "start:log": "nest start log-service --watch",
    "start:log-service": "nest start log-service --watch",
    "start:core_app": "cross-env NODE_ENV=PRODUCTION nest start core_app --watch",
    "start:auth": "cross-env NODE_ENV=PRODUCTION nest start auth --watch",
    "start:files": "cross-env ENV_FILE=./apps/files/.production.env node dist/apps/files/main",
    "start:dev:core_app": "cross-env NODE_ENV=DEV nest start core_app --watch --debug=9009",
    "start:dev:auth": "cross-env NODE_ENV=DEV nest start auth --watch --debug",
    "start:dev:files": "cross-env ENV_FILE=./apps/files/.development.env nest start files --watch",
    "start:test:core_app": "cross-env NODE_ENV=TEST nest start core_app --watch --debug=9009",
    "start:test:auth": "cross-env NODE_ENV=TEST nest start auth --watch --debug",
    "migrate:core_app:dev": "dotenv -e ./apps/core_app/.development.env -- npx prisma migrate dev --schema=./apps/core_app/prisma/schema.prisma",
    "migrate:core_app:prod": "dotenv -e ./apps/core_app/.production.env -- npx prisma migrate deploy --schema=./apps/core_app/prisma/schema.prisma",
    "migrate:core_app:test": "dotenv -e ./apps/core_app/.test.env -- npx prisma migrate dev --schema=./apps/core_app/prisma/schema.prisma",
    "migrate:statusdev": "cross-env ENV_FILE=.development.env npx prisma migrate status",
    "migrate:statusprod": "cross-env ENV_FILE=.production.env npx prisma migrate status",
    "migrate:hotfix": "cross-env ENV_FILE=.production.env npx prisma migrate resolve --applied",
    "migrate:auth:dev": "dotenv -e ./apps/auth/.development.env -- npx prisma migrate dev --schema=./apps/auth/prisma/schema.prisma",
    "migrate:auth:prod": "dotenv -e ./apps/auth/.production.env -- npx prisma migrate deploy --schema=./apps/auth/prisma/schema.prisma",
    "migrate:auth:test": "dotenv -e ./apps/auth/.test.env -- npx prisma migrate dev --schema=./apps/auth/prisma/schema.prisma",
    "generate:auth": "dotenv -e ./apps/core_app/.development.env -- npx prisma generate --schema=./apps/auth/prisma/schema.prisma",
    "generate:core_app": "dotenv -e ./apps/core_app/.development.env -- npx prisma generate --schema=./apps/core_app/prisma/schema.prisma",
    "libs:builds": "nest build shared-dto && nest build auth-api && nest build core-app-api && nest build email-service && nest build guards && nest build filters && nest build rabbit_client_logger"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@libs/shared-dto": "file:./libs/shared-dto",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^11.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@newrelic/winston-enricher": "^4.0.1",
    "@prisma/client": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/newrelic": "^9.14.7",
    "@types/passport-github2": "^1.2.9",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "multer": "^1.4.5-lts.1",
    "newrelic": "^12.11.2",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-jwt": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^4.1.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/shared-dto(|/.*)$": "<rootDir>/libs/shared-dto/src/$1",
      "^@core-app-api/core-app-api(|/.*)$": "<rootDir>/libs/core-app-api/src/$1",
      "^auth-api/auth-api(|/.*)$": "<rootDir>/libs/auth-api/src/$1",
      "^@prisma/auth(|/.*)$": "<rootDir>/apps/auth/prisma/schema_generate/$1",
      "^@prisma/core_app(|/.*)$": "<rootDir>/apps/core_app/prisma/schema_generate/$1",
      "@core_app(|/.*)$": "<rootDir>/apps/core_app/$1",
      "@auth(|/.*)$": "<rootDir>/apps/auth/$1",
      "^@app/email-service(|/.*)$": "<rootDir>/libs/email-service/src/$1",
      "^@app/guards(|/.*)$": "<rootDir>/libs/guards/src/$1",
      "^@app/filters(|/.*)$": "<rootDir>/libs/filters/src/$1",
      "^@app/rabbit_client_logger(|/.*)$": "<rootDir>/libs/rabbit_client_logger/src/$1"
    }
  },
  "main": "index.js",
  "repository": "https://github.com/Smart-team-It-incubator/backend-inctagram"
}
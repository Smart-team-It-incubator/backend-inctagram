generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output = "schema_generate"
  log      = ["query", "info", "warn", "error"] // Логирование запросов, информационных сообщений, предупреждений и ошибок
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  createdAt              DateTime  @default(now())
  emailConfirmationCode  String?
  emailConfirmationCodeExpirationDate DateTime?
  firstName              String?
  isEmailConfirmed       Boolean   @default(false)
  lastLogin              DateTime?
  lastName               String?
  profileImageUrl        String?
  resetPasswordExpires   DateTime?
  resetPasswordToken     String?
  role                   String    @default("user")
  updatedAt              DateTime? @updatedAt
  password               String?
  username               String    @unique
  city                   String?
  country                String?
  dateOfBirthday         DateTime?
  githubId        String?   @unique                         // Github ID
  Post	Post[]
  Comment Comment[] 
}

model Post {
  id         String    @id @default(uuid())
  text       String?
  location   String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  photos     Photo[]   // Связь с фотографиями
  comments    Comment[] // Связь с комментариями
}

model Photo {
  id       String    @id @default(uuid())
  url      String   // Ссылка на файл в S3
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  photoDescription String?
  postId   String
}


model Comment {
  id       String  @id @default(uuid()) 
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade) 
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade) 
  userId   String
  postId   String
  text     String  
  createdAt DateTime @default(now())
}